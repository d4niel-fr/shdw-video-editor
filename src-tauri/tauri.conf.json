{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shdw",
  "version": "1.0.0",
  "identifier": "com.shdw.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "shdw",
        "width": 1680,
        "height": 1020,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0a0a0c",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "d4niel-fr",
    "copyright": "Copyright (C) 2026 d4niel-fr — AGPL-3.0 with attribution terms",
    "category": "Video",
    "shortDescription": "AI-native video editor with Claude Code / Codex built in",
    "longDescription": "shdw is an open-source, DaVinci Resolve-style video editor where Claude Code or Codex edits your timeline, writes motion graphics in code, grades, captions and exports.",
    "homepage": "https://github.com/d4niel-fr/shdw-video-editor",
    "license": "AGPL-3.0-only",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}